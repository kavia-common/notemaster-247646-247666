# PostgreSQL connection (must match notes_database). Example from db_connection.txt:
# postgresql://appuser:dbuser123@localhost:5000/myapp
POSTGRES_URL=

# JWT auth
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS: comma-separated list of allowed frontend origins (Next.js dev/prod)
CORS_ALLOW_ORIGINS=http://localhost:3000
